rules_version = '2';

// Every user is an anonymous Firebase Auth account (see initFirebaseMessaging
// in app.js) whose uid is the document id — so each device can only ever
// read or write its own profile and daily reminder state, never anyone else's.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /dailyState/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contact form (app.js "تواصل معنا"): intentionally unauthenticated and
    // write-only — no email/personal ID is required from the sender, and no
    // one can read someone else's message back through the client SDK. The
    // project owner reviews submissions directly in the Firebase console.
    // Field/size checks below are basic hygiene, not real abuse protection —
    // there's no rate limiting or CAPTCHA in front of this.
    match /contactMessages/{messageId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (!('name' in request.resource.data) || request.resource.data.name == null || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
        && (!('email' in request.resource.data) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 200));
    }
  }
}
